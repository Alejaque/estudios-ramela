{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/health", "destination": "/api/salud" },
    { "source": "/api/study", "destination": "/api/estudio" },
    { "source": "/api/study/stream", "destination": "/api/flujo-de-estudio" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
