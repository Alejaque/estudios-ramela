{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "functions": {
    "api/**/*.ts": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    { "source": "/api/health", "destination": "/api/health" },
    { "source": "/api/study/stream", "destination": "/api/study-stream" },
    { "source": "/api/study", "destination": "/api/study" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
